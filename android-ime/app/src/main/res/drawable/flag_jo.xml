<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#0D351F"
                android:centerColor="#1B1C20"
                android:endColor="#0F1014" />
        </shape>
    </item>
    <item android:gravity="top|right" android:width="110dp" android:height="110dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:startColor="#55BA2428"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
