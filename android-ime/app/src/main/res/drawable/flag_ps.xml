<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#0D3B1C"
                android:centerColor="#18181B"
                android:endColor="#111113" />
        </shape>
    </item>
    <item android:gravity="top|right" android:width="120dp" android:height="120dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:startColor="#66C0242B"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
